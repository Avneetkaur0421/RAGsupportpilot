# Copy this file to .env, pick ONE chat provider below, and fill in its key.
# Model names change often: check your provider's docs for current ones.

# ===== Who the assistant works for =====
ORG_NAME=Kestrel Cycles
ORG_DESCRIPTION=a fictional e-bike brand

# ===== Chat model (answers, follow-ups, reading images) =====
# Option A: Claude (default)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Option C: any OpenAI-compatible server (Groq, OpenRouter, DeepSeek, Together, vLLM, LM Studio)
# LLM_PROVIDER=openai
# LLM_MODEL=<model name from that service>
# OPENAI_API_KEY=<that service's key>
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Option D: Gemini with an API key
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=...

# Option E: Gemini on Google Cloud (pip install langchain-google-vertexai, then gcloud auth)
# LLM_PROVIDER=vertexai
# LLM_MODEL=gemini-2.5-flash

# Option F: Azure OpenAI (LLM_MODEL is your deployment name)
# LLM_PROVIDER=azure
# LLM_MODEL=my-gpt-deployment
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21

# Option G: free local model with Ollama (install Ollama, then: ollama pull llama3.1)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# ===== Embedding model (search) =====
# local = free, runs on your machine. Switching later is safe: passages are re-embedded automatically.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
# EMBEDDING_PROVIDER=openai   EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=google   EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_PROVIDER=ollama   EMBEDDING_MODEL=nomic-embed-text

# ===== Retrieval and chunking =====
TOP_K=4
MIN_RELEVANCE=0.30
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ===== Other =====
# Let the chat model read images and scanned PDFs (needs a model that accepts images/PDFs).
VISION_EXTRACT=true
HISTORY_TURNS=3
MAX_UPLOAD_MB=25
