# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Cheap and fast for demos. Switch to claude-sonnet-5-5 for higher-quality answers.
LLM_MODEL=claude-haiku-4-5-20251001

# How many passages to retrieve, and the minimum relevance (0 to 1) to keep one.
TOP_K=4
MIN_RELEVANCE=0.30

# Chunking: max characters per passage, and how much neighbouring passages overlap.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
